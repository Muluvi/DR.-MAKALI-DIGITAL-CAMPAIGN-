# Site Configuration
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
SITE_PASSCODE=

# The campaign platform (docs/ownership-2026-11/HANDOFF.md). Names only: set the values in Vercel.
# Team sign-in and editing are off unless this is "on"; while off the site is open to view only.
PLATFORM_TEAM_LOGIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FIREFLY_ADMIN_EMAILS=
GITHUB_REPOSITORY_SLUG=
# Either a GitHub App (preferred)...
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# ...or a fine-grained token with Contents read/write on this repository only.
GITHUB_EDIT_TOKEN=

# Development only: run the platform on a local file store with test accounts.
# PLATFORM_STORE=local
# PLATFORM_LOCAL_USERS=email|password|Name,email|password|Name
# PLATFORM_LOCAL_SECRET=

# The campaigner network (docs/network/README.md). Names only: set the values in Vercel.
# Every route that reads or writes personal data answers 404 unless this is "on".
NETWORK_PRIVATE=
# Firefly's WhatsApp Business API (Cloud API) and an approved utility template with one body parameter.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=
# Firefly's USSD shortcode: the gateway's callback is /api/network/ussd?key=<USSD_WEBHOOK_SECRET>.
USSD_WEBHOOK_SECRET=
# Optional: an outbound USSD push, only where the gateway offers one.
USSD_PUSH_URL=
USSD_PUSH_KEY=
# Development only (PLATFORM_STORE=local): the one-time code accepted for local network sign-in.
# NETWORK_LOCAL_CODE=
