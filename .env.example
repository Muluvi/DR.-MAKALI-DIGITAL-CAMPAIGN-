# Site Configuration
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
SITE_PASSCODE=

# The campaign platform (docs/ownership-2026-11/HANDOFF.md). Names only: set the values in Vercel.
# The site is read-only: there is no sign-in and no editing. Supabase is read with the service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_REPOSITORY_SLUG=
# Either a GitHub App (preferred)...
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# ...or a fine-grained token with read access to this repository only (the change history reads
# whether past edits passed their checks).
GITHUB_EDIT_TOKEN=

# Development only: read the platform from a local file store (.platform-local/store.json).
# PLATFORM_STORE=local
