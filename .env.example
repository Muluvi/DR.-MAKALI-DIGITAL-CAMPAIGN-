# Settings for the live site. Names only: set the values in Vercel (Project, Settings,
# Environment Variables). docs/DEPLOY.md says what each one does and which are required.

# The site's public address, for links and the sitemap.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# The workspace database (Supabase). With both set, anyone with the link can save records.
# There is no sign-in. The service-role key stays on the server; never expose it to a browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set to "paused" to stop all saving for everyone while unwanted changes are put back.
PLATFORM_EDITING=

# Data-pack edits from /edit-data are committed to this repository and go live only once the
# data checks pass. Either a GitHub App (preferred)...
GITHUB_REPOSITORY_SLUG=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# ...or a fine-grained token with Contents read/write on this repository only.
GITHUB_EDIT_TOKEN=

# Optional AI step for the models' instruction boxes. Unset: off, and free.
ANTHROPIC_API_KEY=
# Most AI requests per server per month (default 1500). Set a spend limit in the Anthropic Console too.
AI_MONTHLY_REQUEST_LIMIT=

# Optional passcode gate (off unless set). Readers open the site once with ?k=<passcode>.
SITE_PASSCODE=

# Development only: run the workspace on a local file store.
# PLATFORM_STORE=local
